# Store these on the gateway host. Never put the Replicate token in website files.
REPLICATE_API_TOKEN=replace-with-your-replicate-token
# Generate a separate access key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JAA_RENDER_ACCESS_KEY=replace-with-a-random-key-at-least-32-characters

# Configure exactly one backend running cloud/replicate's JAA renderer.
REPLICATE_DEPLOYMENT=your-account/jaa-renderer
# REPLICATE_VERSION=your-pinned-64-character-model-version

JAA_ALLOWED_ORIGINS=https://jrdn-r.github.io
# Add an exact local origin to the list only when testing locally.
# JAA_ALLOWED_ORIGINS=https://jrdn-r.github.io,http://localhost:8080

# Paste cloud/replicate/renderer-version.txt to reject outdated sites before billing.
# JAA_RENDERER_VERSION=your-64-character-renderer-source-hash
# List only exact font families installed in the renderer image. An empty list
# requires the editor to include an uploaded/custom font in each cloud project.
JAA_RENDER_FONT_FAMILIES=
JAA_MAX_ACTIVE=2
JAA_JOBS_PER_HOUR=30
JAA_MAX_JOBS=1000
PORT=8787
